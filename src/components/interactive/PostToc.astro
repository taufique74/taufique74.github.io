---
/**
 * In-post table of contents with scrollspy, in the style of the Alignment
 * Atlas artifact sidebars.
 *
 * On wide viewports (>= 1360px, where there is free margin beside the 720px
 * article column) it becomes a fixed left rail; below that it is a sticky
 * horizontal strip that scrolls with the reader. Items point at element ids
 * that must exist in the post (use explicit `<h2 id="...">` headings).
 */
interface Item {
  id: string;
  label: string;
  /** Optional group header rendered above this item (rail layout only). */
  group?: string;
}

interface Props {
  title: string;
  items: Item[];
}

const { title, items } = Astro.props;
const uid = `ptoc-${Math.random().toString(36).slice(2, 9)}`;
---

<nav class="ptoc not-prose" aria-label="Table of contents" data-ptoc={uid}>
  <p class="ptoc__title">{title}</p>
  {
    items.map(item => (
      <>
        {item.group && <p class="ptoc__group">{item.group}</p>}
        <a href={`#${item.id}`} data-ptoc-link={item.id}>
          {item.label}
        </a>
      </>
    ))
  }
</nav>

<style>
  .ptoc {
    /* Horizontal strip (default) */
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    gap: 0.25rem;
    align-items: center;
    overflow-x: auto;
    white-space: nowrap;
    margin: 0 -1rem 1.5rem;
    padding: 0.55rem 1rem;
    background: color-mix(in srgb, var(--background) 92%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--border);
    scrollbar-width: none;
  }
  .ptoc::-webkit-scrollbar {
    display: none;
  }

  .ptoc__title,
  .ptoc__group {
    display: none;
  }

  .ptoc a {
    font-family: var(--font-google-sans-code, ui-monospace, monospace);
    font-size: 0.78rem;
    line-height: 1.35;
    color: var(--foreground);
    opacity: 0.65;
    text-decoration: none;
    padding: 0.3rem 0.6rem;
    border-radius: 6px;
    flex: 0 0 auto;
    border-bottom: 2px solid transparent;
  }
  .ptoc a:hover {
    opacity: 1;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }
  .ptoc a[aria-current="true"] {
    opacity: 1;
    color: var(--accent);
    font-weight: 600;
    border-bottom-color: var(--accent);
    border-radius: 6px 6px 0 0;
  }

  /* Left rail on wide screens: sits in the free margin beside the column */
  @media (min-width: 1360px) {
    .ptoc {
      position: fixed;
      top: 7rem;
      left: calc(50vw - 24rem - 15.5rem);
      width: 14rem;
      max-height: calc(100vh - 9rem);
      overflow-y: auto;
      display: block;
      white-space: normal;
      margin: 0;
      padding: 0 0.25rem 1rem;
      background: transparent;
      backdrop-filter: none;
      border-bottom: none;
    }

    .ptoc__title {
      display: block;
      font-family: var(--font-google-sans-code, ui-monospace, monospace);
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: var(--foreground);
      opacity: 0.5;
      font-weight: 600;
      margin: 0 0.5rem 0.8rem;
    }
    .ptoc__group {
      display: block;
      font-family: var(--font-google-sans-code, ui-monospace, monospace);
      font-size: 0.62rem;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: var(--foreground);
      opacity: 0.45;
      margin: 1rem 0.5rem 0.3rem;
    }

    .ptoc a {
      display: block;
      padding: 0.32rem 0.55rem;
      margin: 1px 0;
      border-bottom: none;
      border-left: 2px solid transparent;
      border-radius: 6px;
    }
    .ptoc a[aria-current="true"] {
      border-left-color: var(--accent);
      background: color-mix(in srgb, var(--accent) 10%, transparent);
      border-radius: 0 6px 6px 0;
    }
  }
</style>

<script>
  function mountToc(nav: HTMLElement) {
    if (nav.dataset.ptocReady === "1") return;
    const links = Array.from(
      nav.querySelectorAll<HTMLAnchorElement>("[data-ptoc-link]")
    );
    const byId = new Map(links.map(a => [a.dataset.ptocLink!, a]));
    let active: HTMLAnchorElement | null = null;

    const spy = new IntersectionObserver(
      entries => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const link = byId.get(entry.target.id);
          if (!link) continue;
          active?.removeAttribute("aria-current");
          active = link;
          link.setAttribute("aria-current", "true");
          // Keep the active pill in view in the horizontal strip.
          link.scrollIntoView({ block: "nearest", inline: "nearest" });
        }
      },
      { rootMargin: "-15% 0px -75% 0px" }
    );

    for (const id of byId.keys()) {
      const el = document.getElementById(id);
      if (el) spy.observe(el);
    }

    document.addEventListener("astro:before-swap", () => spy.disconnect(), {
      once: true,
    });
    nav.dataset.ptocReady = "1";
  }

  function mountAllTocs() {
    document.querySelectorAll<HTMLElement>("[data-ptoc]").forEach(mountToc);
  }

  document.addEventListener("astro:page-load", mountAllTocs);
  if (document.readyState !== "loading") mountAllTocs();
  else document.addEventListener("DOMContentLoaded", mountAllTocs);
</script>
