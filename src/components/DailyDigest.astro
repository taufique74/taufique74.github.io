---
// Renders one day of the "What's New Daily" digest (papers + tech radar + briefly noted).
// Note on tokens: on this site --muted is a SURFACE color (chips, scrollbars),
// never a text color — secondary text uses text-foreground at reduced opacity.
interface Link {
  label: string;
  url: string;
}
interface Paper {
  title: string;
  org: string;
  summary: string;
  why?: string;
  tags?: string[];
  upvotes?: number;
  links: Link[];
}
interface RadarItem {
  source: string;
  author: string;
  title: string;
  summary: string;
  why?: string;
  tags?: string[];
  url?: string;
}
interface NotedItem {
  source: string;
  author: string;
  summary: string;
}
export interface DailyData {
  date: string;
  papers: Paper[];
  radar?: RadarItem[];
  noted?: NotedItem[];
}

const { day } = Astro.props as { day: DailyData };
---

<div class="flex flex-col gap-10">
  <section>
    <h2 class="mb-4 text-xl font-semibold">
      Papers <sup class="text-sm text-foreground/60">{day.papers.length}</sup>
    </h2>
    <ul class="flex flex-col gap-4">
      {
        day.papers.map(p => (
          <li class="rounded-lg border border-border p-4">
            <h3 class="font-semibold text-balance">
              {p.links[0]?.url ? (
                <a
                  href={p.links[0].url}
                  class="hover:text-accent hover:underline"
                >
                  {p.title}
                </a>
              ) : (
                p.title
              )}
            </h3>
            <p class="mt-1 font-mono text-xs tracking-wide text-foreground/60 uppercase">
              {p.org}
              {typeof p.upvotes === "number" && (
                <span class="ms-2 font-semibold whitespace-nowrap text-accent">
                  ▲{p.upvotes}
                </span>
              )}
            </p>
            <p class="mt-2 text-sm">{p.summary}</p>
            {p.why && (
              <p class="mt-2 border-s-2 border-accent/50 ps-2 text-sm text-foreground/75 italic">
                {p.why}
              </p>
            )}
            <p class="mt-3 flex flex-wrap items-center gap-1.5">
              {(p.tags ?? []).map(t => (
                <span class="rounded-full bg-muted px-2 py-0.5 font-mono text-xs font-medium text-foreground/90">
                  #{t}
                </span>
              ))}
              {p.links.map(l => (
                <a
                  href={l.url}
                  class="rounded-full bg-muted px-2 py-0.5 font-mono text-xs font-semibold text-accent hover:underline"
                >
                  {l.label} ↗
                </a>
              ))}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  {
    day.radar && day.radar.length > 0 && (
      <section>
        <h2 class="mb-4 text-xl font-semibold">
          Tech radar{" "}
          <sup class="text-sm text-foreground/60">{day.radar.length}</sup>
        </h2>
        <ul class="flex flex-col gap-4">
          {day.radar.map(r => (
          <li class="rounded-lg border border-border p-4">
            <h3 class="font-semibold text-balance">
              {r.url ? (
                <a href={r.url} class="hover:text-accent hover:underline">
                  {r.title}
                </a>
              ) : (
                r.title
              )}
            </h3>
            <p class="mt-1 font-mono text-xs tracking-wide text-foreground/60 uppercase">
              {r.author}
            </p>
            <p class="mt-2 text-sm">{r.summary}</p>
            {r.why && (
              <p class="mt-2 border-s-2 border-accent/50 ps-2 text-sm text-foreground/75 italic">
                {r.why}
              </p>
            )}
            <p class="mt-3 flex flex-wrap items-center gap-1.5">
              {(r.tags ?? []).map(t => (
                <span class="rounded-full bg-muted px-2 py-0.5 font-mono text-xs font-medium text-foreground/90">
                  #{t}
                </span>
              ))}
              {r.url ? (
                <a
                  href={r.url}
                  class="rounded-full bg-muted px-2 py-0.5 font-mono text-xs font-semibold text-accent hover:underline"
                >
                  {r.source} ↗
                </a>
              ) : (
                <span class="rounded-full bg-muted px-2 py-0.5 font-mono text-xs font-medium text-foreground/90">
                  {r.source}
                </span>
              )}
            </p>
          </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    day.noted && day.noted.length > 0 && (
      <section>
        <h2 class="mb-4 text-xl font-semibold">
          Briefly noted{" "}
          <sup class="text-sm text-foreground/60">{day.noted.length}</sup>
        </h2>
        <ul class="flex list-disc flex-col gap-2 ps-5">
          {day.noted.map(n => (
            <li class="text-sm">
              <span class="font-medium">{n.author}</span>
              <span class="text-foreground/60"> ({n.source})</span> —{" "}
              {n.summary}
            </li>
          ))}
        </ul>
      </section>
    )
  }
</div>
